{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "760px", "wideSize": "1320px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "cream",           "name": "Crème",           "color": "#FBF7F2" },
				{ "slug": "white",           "name": "Blanc",           "color": "#FFFFFF" },
				{ "slug": "blush",           "name": "Rose poudré",     "color": "#F7E6E0" },
				{ "slug": "petal",           "name": "Pétale",          "color": "#F3DDD6" },
				{ "slug": "rose",            "name": "Rose",            "color": "#ECCEC4" },
				{ "slug": "coral",           "name": "Corail",          "color": "#E4A593" },
				{ "slug": "terracotta",      "name": "Terracotta",      "color": "#A65F4F" },
				{ "slug": "terracotta-dark", "name": "Terracotta foncé","color": "#8C4E41" },
				{ "slug": "sand",            "name": "Sable",           "color": "#E6DBCB" },
				{ "slug": "sage",            "name": "Sauge",           "color": "#C9D3C1" },
				{ "slug": "sapin",           "name": "Vert sapin",      "color": "#2F4A3E" },
				{ "slug": "sapin-light",     "name": "Vert sapin clair","color": "#DCE5DA" },
				{ "slug": "mist",            "name": "Brume",           "color": "#BED3D6" },
				{ "slug": "gold",            "name": "Or patiné",       "color": "#B8975A" },
				{ "slug": "ink",             "name": "Encre",           "color": "#3A2E2B" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontSizes": [
				{ "slug": "x-small",  "name": "Très petit", "size": "0.8125rem", "fluid": false },
				{ "slug": "small",    "name": "Petit",      "size": "0.875rem",  "fluid": false },
				{ "slug": "medium",   "name": "Moyen",      "size": "1rem",      "fluid": false },
				{ "slug": "large",    "name": "Grand",      "size": "1.375rem",  "fluid": { "min": "1.25rem", "max": "1.375rem" } },
				{ "slug": "x-large",  "name": "Très grand", "size": "3.2rem",    "fluid": { "min": "2rem",    "max": "3.2rem" } },
				{ "slug": "xx-large", "name": "Énorme",     "size": "5.2rem",    "fluid": { "min": "2.8rem",  "max": "5.2rem" } }
			],
			"fontFamilies": [
				{
					"slug": "title",
					"name": "Fraunces",
					"fontFamily": "Fraunces, Georgia, serif",
					"fontFace": [
						{ "fontFamily": "Fraunces", "fontWeight": "300 600", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/fraunces-latin.woff2" ] },
						{ "fontFamily": "Fraunces", "fontWeight": "300 600", "fontStyle": "italic", "fontDisplay": "swap", "src": [ "file:./assets/fonts/fraunces-italic-latin.woff2" ] }
					]
				},
				{
					"slug": "text",
					"name": "Outfit",
					"fontFamily": "Outfit, system-ui, sans-serif",
					"fontFace": [
						{ "fontFamily": "Outfit", "fontWeight": "300 600", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/outfit-latin.woff2" ] }
					]
				}
			]
		}
	},
	"styles": {
		"color": { "background": "var:preset|color|cream", "text": "var:preset|color|ink" },
		"spacing": {
			"blockGap": "1.5rem",
			"padding": { "left": "clamp(16px, 3.5vw, 40px)", "right": "clamp(16px, 3.5vw, 40px)" }
		},
		"typography": {
			"fontFamily": "var:preset|font-family|text",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"typography": { "fontFamily": "var:preset|font-family|title", "fontWeight": "350", "lineHeight": "1.05", "letterSpacing": "-0.02em" }
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|xx-large" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
			"h3": { "typography": { "fontSize": "var:preset|font-size|large" } },
			"link": {
				"color": { "text": "var:preset|color|ink" },
				":hover": { "color": { "text": "var:preset|color|terracotta" } }
			},
			"button": {
				"color": { "background": "var:preset|color|terracotta", "text": "var:preset|color|white" },
				"border": { "radius": "999px", "width": "0" },
				"spacing": { "padding": { "top": "15px", "bottom": "15px", "left": "26px", "right": "26px" } },
				"typography": { "fontFamily": "var:preset|font-family|text", "fontSize": "15px", "fontWeight": "500", "lineHeight": "1" },
				":hover": { "color": { "background": "var:preset|color|terracotta-dark" } }
			}
		}
	},
	"templateParts": [
		{ "name": "header",       "title": "En-tête",                     "area": "header" },
		{ "name": "footer",       "title": "Pied de page",                "area": "footer" },
		{ "name": "checkout-header", "title": "En-tête de la commande",    "area": "header" },
		{ "name": "checkout-footer", "title": "Pied de page de la commande", "area": "footer" },
		{ "name": "hero",         "title": "Accueil — Bandeau principal", "area": "uncategorized" },
		{ "name": "categories",   "title": "Accueil — Nos collections",   "area": "uncategorized" },
		{ "name": "new-arrivals", "title": "Accueil — Nouveautés",        "area": "uncategorized" },
		{ "name": "gifts",        "title": "Accueil — Idées cadeaux",     "area": "uncategorized" },
		{ "name": "reassurance",  "title": "Réassurance",                 "area": "uncategorized" },
		{ "name": "store",        "title": "Accueil — Le magasin",        "area": "uncategorized" },
		{ "name": "instagram",    "title": "Accueil — Instagram",         "area": "uncategorized" },
		{ "name": "newsletter",   "title": "Newsletter",                  "area": "uncategorized" },
		{ "name": "event",        "title": "Événement (pastille et panneau)", "area": "uncategorized" }
	]
}
